# BugCode Shield local / Compose configuration
# Copy this file to .env and replace placeholder secrets before starting.
# scripts/setup.sh can generate random passwords for you.

APP_ENV=development
APP_VERSION=0.1.0
LOG_FORMAT=json

# Published on the host as 127.0.0.1:<port>
WEB_PORT=3000
API_PORT=3001

# --- PostgreSQL ---
POSTGRES_USER=bugcodeshield
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=bugcodeshield
POSTGRES_SSLMODE=disable
# Used when running the API on the host. Compose overrides this to "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change-me-redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- RabbitMQ ---
RABBITMQ_USER=bugcodeshield
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_PORT=15672

# --- MinIO ---
MINIO_ROOT_USER=bugcodeshield
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=bugcodeshield
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001

# Next.js server-side proxy target. Compose sets this to http://api:3000.
API_INTERNAL_URL=http://localhost:3001

# Auth and source-token encryption. setup.sh generates these.
JWT_SECRET=change-me-jwt-secret-please-use-setup-script
ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Optional AI assistant (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- SonarQube (optional scanner; server starts with Compose) ---
# Host UI: http://localhost:9002  (default admin / this password after first scan)
SONARQUBE_PORT=9002
SONARQUBE_ADMIN_PASSWORD=ChangeMe_sonar1!
